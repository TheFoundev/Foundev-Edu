{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundev.example/schemas/project.schema.json",
  "title": "Foundev learning content project",
  "type": "object",
  "required": ["title", "slug", "description", "problem_solved", "target_audience", "technology_stack", "difficulty_level", "prerequisites", "learning_outcomes", "estimated_completion_time", "content_schema_version"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1},
    "problem_solved": {"type": "string", "minLength": 1},
    "target_audience": {"type": "string", "minLength": 1},
    "technology_stack": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "difficulty_level": {"enum": ["beginner", "intermediate", "advanced"]},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "learning_outcomes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "estimated_completion_time": {"type": "string"},
    "content_schema_version": {"type": "string"}
  },
  "additionalProperties": false
}
