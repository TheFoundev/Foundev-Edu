{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundev.example/schemas/module.schema.json",
  "title": "Learning content module",
  "type": "object",
  "required": [
    "module_id",
    "title",
    "description",
    "learning_objectives",
    "prerequisites",
    "lesson_ids",
    "estimated_duration",
    "concepts_covered",
    "practical_outcomes",
    "completion_criteria",
    "source_files",
    "source_code_focus"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^module-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lesson_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "estimated_duration": {
      "type": "string"
    },
    "concepts_covered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "practical_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_code_focus": {
      "type": "object",
      "required": [
        "excerpt_file",
        "symbol_or_search_term",
        "line_start",
        "line_end"
      ],
      "properties": {
        "excerpt_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol_or_search_term": {
          "type": "string"
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
