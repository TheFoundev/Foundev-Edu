{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module.schema.json",
  "type": "object",
  "required": [
    "module_id",
    "title",
    "description",
    "learning_objectives",
    "learning_objective_ids",
    "source_files",
    "prerequisites",
    "ordered_lesson_ids",
    "estimated_duration_minutes",
    "concepts",
    "practical_outcomes",
    "completion_criteria"
  ],
  "properties": {
    "module_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "learning_objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ordered_lesson_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "estimated_duration_minutes": {
      "type": "integer"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "practical_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
