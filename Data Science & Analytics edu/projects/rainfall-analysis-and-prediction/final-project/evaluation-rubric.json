        "insufficient": "Unsafe data/credential practice"
      }
    },
    {
      "criterion": "Communication",
      "weight": 10,
      "levels": {
        "excellent": "Clear deliverables and limits",
        "developing": "Minor gaps",
        "insufficient": "Unclear or misleading"
      }
    }
  ]
