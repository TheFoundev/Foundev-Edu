{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "module_id",
    "title",
    "description",
    "source_files",
    "learning_objectives",
    "prerequisites",
    "ordered_lesson_ids",
    "estimated_duration_minutes",
    "concepts",
    "practical_outcomes",
    "completion_criteria"
  ],
  "properties": {
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
