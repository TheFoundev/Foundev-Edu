{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "module_id",
    "questions"
  ],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "text",
          "options",
          "difficulty",
          "learning_objective_id",
          "related_lesson_id"
        ],
        "properties": {
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  }
}
